<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- স্ক্রিনের ওপর বাবল ভাসানোর জন্য জরুরি পারমিশন -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- ব্যাকগ্রাউন্ডে সার্ভিস সচল রাখার পারমিশন -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="JARVIS Floating"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.NoActionBar">

        <!-- আপনার মেইন অ্যাক্টিভিটি (যা দিয়ে অ্যাপ ওপেন হবে) -->
        <activity
            android:name="com.example.myno.floatingwindow.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- আমাদের নতুন ফ্লোটিং বাবল সার্ভিস -->
        <service
            android:name="com.example.myno.floatingwindow.FloatingService"
            android:enabled="true"
            android:exported="false" />
            
    </application>

</manifest>